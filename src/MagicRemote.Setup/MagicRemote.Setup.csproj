<Project Sdk="Microsoft.NET.Sdk">
  <!-- Web installer: one small exe on .NET Framework 4.8 (built into Windows 10/11), downloads the latest win-x64 release and installs it with the app's own install switch. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>MagicRemote-Setup</AssemblyName>
    <RootNamespace>MagicRemote.Setup</RootNamespace>
    <ApplicationIcon>..\MagicRemote\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
